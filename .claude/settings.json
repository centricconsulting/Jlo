{
  "permissions": {
    "allow": [
      "Bash(suitecloud project:deploy*)",
      "Bash(SKIP_TESTS=true suitecloud project:deploy*)",
      "Bash(suitecloud project:validate*)",
      "Bash(suitecloud object:import*)",
      "Bash(suitecloud object:list*)",
      "Bash(suitecloud account:manageauth --list*)",
      "Bash(ns-validate*)",
      "Bash(tsc*)",
      "Bash(npm test*)"
    ]
  },
  "enabledPlugins": {
    "ns@centric-netsuite": true,
    "netsuite-suitecloud@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "centric-netsuite": {
      "source": {
        "source": "github",
        "repo": "centricconsulting/netsuite-claude-plugins"
      }
    }
  }
}
