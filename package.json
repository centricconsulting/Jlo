    "eslint": "^9.39.1",
    "jest": "29.7.0",
    "jest-junit": "^16.0.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "npm": ">=8.0.0"
  },
  "packageManager": "npm@10.0.0"
